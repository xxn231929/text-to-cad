; ============================================================
; 起重螺杆 - 主视图 + 俯视图
; 总高=144mm，各段从下往上累积
; ============================================================

OSMODE 0
SNAP OFF
GRID OFF

; === 图层 ===
-LAYER M "CENTER" C 1 L "CENTER" ""
-LAYER M "OUTLINE" C 7 L "Continuous" ""
-LAYER M "HIDDEN" C 4 L "HIDDEN" ""
-LAYER M "HATCH" C 8 L "Continuous" ""

; ═══════════════════════════════════════
; 主视图 - 中心线 X=0, 底部 Y=0
; ═══════════════════════════════════════

-LAYER S "CENTER"
LINE 0,-8 0,155

-LAYER S "OUTLINE"

; ── 段1: φ20圆头 (球头把手) ──
; 半圆 R10，圆心(0,10)
ARC C 0,10 10,10 0,0
ARC C 0,10 0,0 -10,10
; 圆柱头高4mm
LINE -10,10 -10,14
LINE 10,10 10,14

; ── 段2: φ12×9 (从Y=14开始) ──
LINE -10,14 -6,14
LINE 10,14 6,14
LINE -6,14 -6,23
LINE 6,14 6,23

; ── 段3: φ16×100 (从Y=23开始) ──
LINE -6,23 -8,23
LINE 6,23 8,23
LINE -8,23 -8,123
LINE 8,23 8,123

; ── 段4: φ32凸台 (从Y=123开始, 高5mm) ──
LINE -8,123 -16,123
LINE 8,123 16,123
LINE -16,123 -16,128
LINE 16,123 16,128

; ── 段5: 上部φ16段 (从Y=128开始, 高6mm, 5×φ16环) ──
LINE -16,128 -8,128
LINE 16,128 8,128
LINE -8,128 -8,134
LINE 8,128 8,134

; ── 段6: φ14d9×10 (从Y=134到Y=144) ──
LINE -8,134 -7,134
LINE 8,134 7,134
LINE -7,134 -7,144
LINE 7,134 7,144

; ── 顶部封口 ──
LINE -7,144 7,144

; ── 凸台上的2×φ13孔(虚线) ──
-LAYER S "HIDDEN"
; 简化：在凸台区域画两个小圆孔示意
LINE 10,125.5 14,125.5
LINE 10,123.5 14,123.5
LINE -10,125.5 -14,125.5
LINE -10,123.5 -14,123.5

; ── 顶部螺纹孔 M8 (虚线) ──
LINE -4,134 -4,144
LINE 4,134 4,144
; 螺纹斜线示意
LINE 4,144 -4,136

; ═══════════════════════════════════════
; 俯视图 - 中心 (80, 72)
; ═══════════════════════════════════════

-LAYER S "CENTER"
LINE 55,72 105,72
LINE 80,47 80,97

-LAYER S "OUTLINE"

; 同心圆（从大到小）
CIRCLE 80,72 16   ; φ32
CIRCLE 80,72 10   ; φ20
CIRCLE 80,72 8    ; φ16
CIRCLE 80,72 7    ; φ14
CIRCLE 80,72 6    ; φ12

; 2×φ13孔（距中心偏移）
CIRCLE 70,72 6.5
CIRCLE 90,72 6.5

-LAYER S "HIDDEN"
; 螺纹底孔
CIRCLE 80,72 4

; ═══════════════════════════════════════
; 标注
; ═══════════════════════════════════════

-LAYER S "OUTLINE"
TEXT -20,155 4 0 起重螺杆
TEXT -30,-20 3 0 主视图
TEXT 65,-20 3 0 俯视图

; === 完成 ===
-LAYER S "0"
ZOOM E
REGEN
; END
